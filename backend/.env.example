# Copy values into the backend process environment; Django does not load this file automatically.
# Local development defaults to SQLite when DJANGO_DEBUG=1 and DB_ENGINE is unset.
DJANGO_DEBUG=1
DB_ENGINE=sqlite

# To use PostgreSQL, set DB_ENGINE=postgresql and provide all required values.
# DB_ENGINE=postgresql
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=replace_with_a_secret
# DB_HOST=your_database_host
# DB_PORT=5432
